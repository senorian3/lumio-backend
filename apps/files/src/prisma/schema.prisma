// Prisma schema for Files microservice
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../../../generated/prisma-files"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PostFile {
  id        Int       @id @default(autoincrement())
  key       String    @unique
  url       String
  mimetype  String
  size      Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  postId    String?
  userId    Int?

  @@index([postId])
  @@index([deletedAt])
  @@index([userId])
}

model UserAvatar {
  id        Int       @id @default(autoincrement())
  key       String    @unique
  url       String
  mimetype  String
  size      Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  userId    Int?      @unique

  @@index([deletedAt])
}

model ChatFile {
  id           Int       @id @default(autoincrement())
  key          String    @unique
  url          String
  type         String    // IMAGE, VOICE, DOCUMENT
  size         Int
  originalName String
  mimeType     String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  userId       Int?
  chatId       Int?
  messageId    String?

  @@index([deletedAt])
  @@index([userId])
  @@index([chatId])
  @@index([messageId])
}

