NODE_ENV=example

#INFRASTRUCTURE + SECRETS + DANGEROUS CONFIGURATION
PORT=1337
INTERNAL_SERVICE_NAME="files"
INTERNAL_API_KEY="example"
INTERNAL_API_KEYS=lumio:example-lumio-to-files-key,chat:example-chat-to-files-key,super-admin:example-super-admin-to-files-key

#DATABASE
DATABASE_URL="postgresql://login:password@localhost:5432/example"

#DOCUMENTATION
IS_SWAGGER_ENABLED=true

#TESTING
INCLUDE_TESTING_MODULE=true

#S3 Yandex
S3_ENDPOINT="string"
S3_REGION="string"
S3_ACCESS_KEY_ID="string"
S3_SECRET_ACCESS_KEY="string"
S3_BUCKET_NAME="string"
