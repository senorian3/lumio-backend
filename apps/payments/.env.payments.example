NODE_ENV=example

#INFRASTRUCTURE + SECRETS + DANGEROUS CONFIGURATION
PORT=1337
INTERNAL_SERVICE_NAME="payments"
INTERNAL_API_KEY="example"
INTERNAL_API_KEYS={"lumio":"example-lumio-to-payments-key","super-admin":"example-super-admin-to-payments-key"}

#DATABASE
DATABASE_URL="postgresql://login:password@localhost:5432/example"
RMQ_URL="amqp://username:password@hostname:port/virtualhost"

#DOCUMENTATION
IS_SWAGGER_ENABLED=true

#TESTING
INCLUDE_TESTING_MODULE=true

#STRIPE
STRIPE_SECRET_KEY="string"
SUCCESS_URL="string"
CANCEL_URL="string"
ENDPOINT_SECRET="string"
